{
  "name": "my-wiki-web-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1 client",
    "start": "tsx server/src/index.ts --open",
    "start:server": "tsx server/src/index.ts",
    "build": "npm run build:client && npm run build:extension && npm run typecheck",
    "build:client": "vite build client",
    "build:extension": "tsx scripts/build-extension.ts",
    "build:pages": "tsx scripts/generate-static.ts && VITE_STATIC_MODE=true vite build client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run server/test client/test extension/src/*.test.ts",
    "test:ui": "tsx smoke.ts",
    "test:pages": "tsx smoke-pages.ts"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.6.5",
    "@tiptap/extension-link": "^3.6.5",
    "@tiptap/extension-placeholder": "^3.6.5",
    "@tiptap/react": "^3.6.5",
    "@tiptap/starter-kit": "^3.6.5",
    "dompurify": "^3.2.6",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "multer": "^2.0.2",
    "open": "^10.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.17.7",
    "turndown": "^7.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
